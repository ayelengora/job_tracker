<%= form_with model: job_application, local: true, class: "mx-auto max-w-lg space-y-4 p-6" do |f| %>
  <% if job_application.errors.any? %>
    <div class="rounded-lg border border-rose-300 bg-rose-50 p-4 text-sm text-rose-700">
      <p class="font-semibold"><%= pluralize(job_application.errors.count, "error") %> impidieron guardar esta postulación:</p>
      <ul class="mt-2 list-disc pl-5">
        <% job_application.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :company, "Empresa", class: "block text-sm font-medium text-neutral-700" %>
    <%= f.text_field :company, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.label :position, "Puesto", class: "block text-sm font-medium text-neutral-700" %>
    <%= f.text_field :position, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :status, "Estado", class: "block text-sm font-medium text-neutral-700" %>
      <%= f.select :status, JobApplication.statuses.keys.map { |k| [k.humanize, k] }, {}, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
    </div>
    <div>
      <%= f.label :interest_level, "Nivel de interés", class: "block text-sm font-medium text-neutral-700" %>
      <%= f.select :interest_level, JobApplication.interest_levels.keys.map { |k| [k.humanize, k] }, {}, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :applied_on, "Fecha de postulación", class: "block text-sm font-medium text-neutral-700" %>
      <%= f.date_field :applied_on, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
    </div>
    <div>
      <%= f.label :last_contacted_on, "Último contacto", class: "block text-sm font-medium text-neutral-700" %>
      <%= f.date_field :last_contacted_on, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
    </div>
  </div>

  <div>
    <%= f.label :interview_round, "Ronda de entrevista", class: "block text-sm font-medium text-neutral-700" %>
    <%= f.number_field :interview_round, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.label :job_url, "Link del aviso", class: "block text-sm font-medium text-neutral-700" %>
    <%= f.url_field :job_url, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.label :notes, "Notas", class: "block text-sm font-medium text-neutral-700" %>
    <%= f.text_area :notes, rows: 4, class: "mt-1 block w-full rounded-md border border-neutral-300 px-3 py-2 text-sm shadow-sm focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
    <%= link_to "Cancelar", job_applications_path, class: "text-sm text-neutral-600 hover:underline" %>
  </div>
<% end %>
